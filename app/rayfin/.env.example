# rayfin/.env — the single source for Rayfin runtime + deployment values.
# Copy to rayfin/.env (git-ignored) and fill in as needed. Do NOT commit real secrets.
#
# Frontend-visible values use the RAYFIN_PUBLIC_* prefix. `rayfin env` (and the
# auto-emit inside `rayfin up`) maps them to framework-specific names in .env.local
# — for this Vite app, RAYFIN_PUBLIC_FOO becomes VITE_RAYFIN_FOO. Never hand-edit
# .env.local; regenerate it with `npm run rayfin:env`.

# ── Populated automatically by `rayfin up` (leave blank before first deploy) ──
# RAYFIN_PUBLIC_API_URL=              # Rayfin backend URL (http://localhost:5168 for local dev)
# RAYFIN_PUBLIC_PUBLISHABLE_KEY=      # Public key for RayfinClient init
# RAYFIN_PUBLIC_ITEM_ID=             # Fabric AppBackend item id (Fabric brokered auth)
# RAYFIN_PUBLIC_WORKSPACE_ID=        # Fabric workspace id (Fabric brokered auth)
# RAYFIN_PUBLIC_TENANT_ID=           # Entra tenant id
# RAYFIN_PUBLIC_PORTAL_URL=          # Fabric portal base URL

# ── User-set ──
# rayfin (real backend) or mock (local UI testing without a backend).
RAYFIN_PUBLIC_SERVICE_MODE=rayfin

# Custom app value: the standalone "Fabric API for GraphQL" endpoint that serves
# ManufacturingLH/dbo.RecentDowntime (the read surface over telemetry). Create it
# per docs/DOWNTIME_LOGBOOK.md, then run `npm run rayfin:env`. This emits
# VITE_RAYFIN_DOWNTIME_GRAPHQL_URL, which src/downtimeApi.ts reads.
RAYFIN_PUBLIC_DOWNTIME_GRAPHQL_URL=https://<your-graphql-endpoint>/graphql

# Optional values interpolated into rayfin.yml (${VAR} syntax), e.g.:
# AUTH_TENANT=default
