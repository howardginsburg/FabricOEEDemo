# Generated dashboard (has user-specific cluster URI / database ID)
dashboard/oee-dashboard.json

# Setup scripts' scratch space (request bodies, definitions); self-cleans, but a failed run can leave files
/.fabric-tmp/

# Simulator runtime config (contains connection strings)
simulator/**/simulator.local.yaml

# .NET build outputs
simulator/**/bin/
simulator/**/obj/

# IDE / editor
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.lscache

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

# Python caches
__pycache__/
*.pyc

# RDF export generated from the ontology TMDL (scripts/6-publish-ontology.py --export-ttl)
/ontology/*.ttl

# Agent evaluation responses and results (scripts/12-evaluate-agent.py)
/agent/evals/results/

# Documentation site build output and local build environment (zensical)
/site/
/.venv-docs/
