/// The OEEAnalytics semantic model's measures table. Each measure here is a reference to the model's DAX
/// measure of the same name, so the KPI is defined once, in the model. scripts/6-publish-ontology.py adds each
/// measure's description, format, and source lineage tag from the model's TMDL and checks it exists.
table _Measures
	lineageTag: 3d5dd38f-57e2-58e6-8e50-3a9b48f0ab1e

	measure OEE = EXTERNALMEASURE("OEE", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 4c7dc957-e3ec-5dd5-988d-e6ae197244b8

	measure Availability = EXTERNALMEASURE("Availability", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: c7009b8c-2c66-524f-8547-da4ca96ad6f9

	measure Performance = EXTERNALMEASURE("Performance", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: e920ffbe-1e11-567e-8f34-de1a81d0b9c0

	measure Quality = EXTERNALMEASURE("Quality", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: c4d7e1ab-3e19-531c-a522-06b968d79209

	measure 'Rejection Rate' = EXTERNALMEASURE("Rejection Rate", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 0c5c194a-df17-548d-a3ca-8956e805802c

	measure Throughput = EXTERNALMEASURE("Throughput", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 74a6baf9-455a-52b7-9a7e-571913905886

	measure 'Parts Finished' = EXTERNALMEASURE("Parts Finished", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
