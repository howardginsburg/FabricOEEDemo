	measure 'MTBF (min)' = EXTERNALMEASURE("MTBF (min)", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 5c24b84d-fde4-533c-9d9a-266303ceec9d

	measure 'OEE — Day' = EXTERNALMEASURE("OEE — Day", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 17fbb975-7b2c-5edd-a52c-9bf1c9ee2575

	measure 'OEE — Night' = EXTERNALMEASURE("OEE — Night", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 049b4940-56af-5040-85ef-115c44af39c5

	measure 'Target OEE' = EXTERNALMEASURE("Target OEE", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
