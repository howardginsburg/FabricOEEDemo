	measure 'Floor Events Logged' = EXTERNALMEASURE("Floor Events Logged", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 871bc70f-e121-5d79-808c-e90537c8e3bb

	measure 'Open Issues' = EXTERNALMEASURE("Open Issues", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 722d061f-4478-50a8-975e-92d6352ba82e

	measure 'Critical Open' = EXTERNALMEASURE("Critical Open", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: adecb74d-5d25-521d-b858-582ce34e39ad

	measure 'Resolved Issues' = EXTERNALMEASURE("Resolved Issues", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 5d34df20-6a3b-52df-9437-fd48cc3c0a84

	measure 'Resolution Rate' = EXTERNALMEASURE("Resolution Rate", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 8dadf328-7b1b-5717-99ce-eb78d2cfd3b3

	measure 'Human MTTA (min)' = EXTERNALMEASURE("Human MTTA (min)", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 06f235f8-5753-590e-b2ac-ff3f81bb8ddc

	measure 'Human MTTR (min)' = EXTERNALMEASURE("Human MTTR (min)", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 3510f9dd-d2ae-599c-afc2-f8fb3ee7f059

	measure 'Scrap Qty' = EXTERNALMEASURE("Scrap Qty", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: a993a458-7a25-5c27-8a24-9d6a6cef3449

	/// The model measures table's placeholder column (always blank). OeeScorecard binds it, because the data
	/// agent reaches a source through the entity properties bound to it.
	column Value
		dataType: int64
		lineageTag: 36cf8ef4-b6b0-57b4-84ec-4aef566c30e9
		sourceColumn: Value

	partition _Measures = entity
		mode: directQuery
		source
			entityName: _Measures
			expressionSource: 'DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__'
