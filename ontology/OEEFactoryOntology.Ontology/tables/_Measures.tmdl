	measure 'Parts Produced' = EXTERNALMEASURE("Parts Produced", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 4ebf881c-f0d5-544c-a1ff-f12b1bcead14

	measure 'Parts Completed' = EXTERNALMEASURE("Parts Completed", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: aae7bc92-6aec-5b9a-af54-7626a0b404a5

	measure 'Parts Rejected' = EXTERNALMEASURE("Parts Rejected", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: d4e7080e-8023-5674-83b9-ae76e206d7da

	measure 'Planned Parts' = EXTERNALMEASURE("Planned Parts", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 39e0a59d-4578-5927-a55b-97776d4f04fd

	measure 'Expected Parts' = EXTERNALMEASURE("Expected Parts", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 2c6a44b7-215f-586d-9d85-e2ca076bdd06

	measure 'Schedule Adherence' = EXTERNALMEASURE("Schedule Adherence", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 70ceb767-25b2-5db7-90ae-a78d1b186698

	measure 'Work Orders' = EXTERNALMEASURE("Work Orders", INTEGER, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
		lineageTag: 81a315ef-9cfe-5d7b-9ce7-edaf182fb8a2

	measure 'MTTR (min)' = EXTERNALMEASURE("MTTR (min)", DOUBLE, "DirectQuery to AS - __WORKSPACE_ID__/__SEMANTIC_MODEL_ID__")
