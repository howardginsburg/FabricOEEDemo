rule ShiftAttribution
	lineageTag: 2b78481c-dca9-5cae-b8f6-31d9efbee1ce
	statement: Every machine, part, and maintenance event belongs to exactly one shift, determined by its timestamp hour against the shift's start_hour and end_hour.

	ruleReferencedEntity production#Shift
		propertyScope: specific
		ruleReferencedProperty start_hour
		ruleReferencedProperty end_hour
