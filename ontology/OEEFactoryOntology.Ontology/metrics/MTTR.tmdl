/// Mean time to repair in minutes: Created to Resolved, averaged over resolved work orders. Same definition as the OEEAnalytics semantic model measure [MTTR (min)].
metric MTTR
	lineageTag: 69dfb911-ecd0-5d31-bd7a-66b2ad3fb37c

	expression
		dialect: SQL
		expression: SELECT AVG(CAST(DATEDIFF(SECOND, c, r) AS FLOAT) / 60) FROM (SELECT work_order_id, MIN(CASE WHEN action = 'Created' THEN timestamp END) AS c, MIN(CASE WHEN action = 'Resolved' THEN timestamp END) AS r FROM dbo.MaintenanceEvents GROUP BY work_order_id) AS w WHERE r >= c

	synonym 'mean time to repair'
	synonym 'repair time'
