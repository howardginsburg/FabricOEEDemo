/// Direct Lake on OneLake: every table binds straight to its Delta table under
/// ManufacturingLH/Tables/dbo, with no SQL analytics endpoint in the query path.
/// scripts/4-setup-powerbi.sh injects the workspace and lakehouse ids into the
/// OneLake URL at deploy time.
expression 'DirectLake - ManufacturingLH' =
		let
			Source = AzureStorage.DataLake("https://onelake.dfs.fabric.microsoft.com/__WORKSPACE_ID__/__LAKEHOUSE_ID__", [HierarchicalNavigation=true])
		in
			Source
	lineageTag: 3f2a9d10-0001-4b7c-9e11-aa0000000001

	annotation PBI_IncludeFutureArtifacts = False

	annotation PBI_ResultType = Table
