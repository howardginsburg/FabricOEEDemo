/// Silver part-level events (one row per part action). Quality & throughput signals.
/// Direct Lake over ManufacturingLH/dbo.PartEvents.
table PartEvents

	column part_id
		dataType: string
		sourceColumn: part_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002001

	column line_id
		dataType: string
		sourceColumn: line_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002002

	column station_position
		dataType: int64
		sourceColumn: station_position
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002003

	column machine_type
		dataType: string
		sourceColumn: machine_type
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002004

	column action
		dataType: string
		sourceColumn: action
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002005

	column cycle_time
		dataType: double
		sourceColumn: cycle_time
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002006

	column is_pass
