		sourceColumn: is_pass
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002007

	column is_completed
		dataType: int64
		sourceColumn: is_completed
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002008

	column is_rejected
		dataType: int64
		sourceColumn: is_rejected
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002009

	column shift_id
		dataType: string
		sourceColumn: shift_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002010

	column timestamp
		dataType: dateTime
		formatString: General Date
		sourceColumn: timestamp
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002011

	partition PartEvents = entity
		mode: directLake
		source
