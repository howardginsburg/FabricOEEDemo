/// Part passes: one row per completed or rejected station pass. Quality and throughput signals.
/// Direct Lake over ManufacturingLH/dbo.PartPasses; device_id relates each pass to its station.
table PartPasses

	column part_id
		dataType: string
		sourceColumn: part_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002001

	column device_id
		dataType: string
		sourceColumn: device_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002012

	column line_id
		dataType: string
		sourceColumn: line_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002002

	column station_position
		dataType: int64
		sourceColumn: station_position
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002003

	column machine_type
		dataType: string
		sourceColumn: machine_type
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002004

	/// completed or rejected.
	column outcome
		dataType: string
		sourceColumn: outcome
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002005

	column cycle_time
		dataType: double
		sourceColumn: cycle_time
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002006

	column is_pass
		dataType: int64
		sourceColumn: is_pass
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002007

	column is_completed
		dataType: int64
		sourceColumn: is_completed
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002008

	column is_rejected
		dataType: int64
		sourceColumn: is_rejected
		summarizeBy: sum
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002009

	column shift_id
		dataType: string
		sourceColumn: shift_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002010

	column passed_at
		dataType: dateTime
		formatString: General Date
		sourceColumn: passed_at
		summarizeBy: none
		lineageTag: 3f2a9d10-1002-4b7c-9e11-aa0000002011

	partition PartPasses = entity
		mode: directLake
		source
			entityName: PartPasses
			schemaName: dbo
			expressionSource: 'DirectLake - ManufacturingLH'
