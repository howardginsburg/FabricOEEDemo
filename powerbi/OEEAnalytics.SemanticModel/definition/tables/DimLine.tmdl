/// Production line dimension. Direct Lake over ManufacturingLH/dbo.LineMaster.
table DimLine

	column line_id
		dataType: string
		isKey
		sourceColumn: line_id
		summarizeBy: none
		lineageTag: 3f2a9d10-2001-4b7c-9e11-aa0000010001

	column line_name
		dataType: string
		sourceColumn: line_name
		summarizeBy: none
		lineageTag: 3f2a9d10-2001-4b7c-9e11-aa0000010002

	column purpose
		dataType: string
		sourceColumn: purpose
		summarizeBy: none
		lineageTag: 3f2a9d10-2001-4b7c-9e11-aa0000010003

	column station_count
		dataType: int64
		sourceColumn: station_count
		summarizeBy: none
		lineageTag: 3f2a9d10-2001-4b7c-9e11-aa0000010004

	partition DimLine = entity
		mode: directLake
		source
			entityName: LineMaster
			schemaName: dbo
			expressionSource: 'DirectLake - ManufacturingLH'
