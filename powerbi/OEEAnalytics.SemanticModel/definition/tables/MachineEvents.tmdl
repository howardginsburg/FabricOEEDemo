/// Silver machine telemetry (one row per machine status sample). Availability &
/// Performance signals. Direct Lake over ManufacturingLH/dbo.MachineEvents.
table MachineEvents

	column device_id
		dataType: string
		sourceColumn: device_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1001-4b7c-9e11-aa0000001001

	column line_id
		dataType: string
		sourceColumn: line_id
		summarizeBy: none
		lineageTag: 3f2a9d10-1001-4b7c-9e11-aa0000001002

	column station_position
