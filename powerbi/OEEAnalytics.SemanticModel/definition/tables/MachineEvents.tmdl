		summarizeBy: none
		lineageTag: 3f2a9d10-1001-4b7c-9e11-aa0000001004

	column machine_status
		dataType: string
		sourceColumn: machine_status
		summarizeBy: none
		lineageTag: 3f2a9d10-1001-4b7c-9e11-aa0000001005

