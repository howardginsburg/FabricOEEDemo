/// Human-entered downtime reason codes from the Rayfin "Downtime Logbook" app
/// (Component B). Surfaced into ManufacturingLH/dbo.DowntimeReason via a OneLake
/// shortcut over the app's managed SQL database. Empty until Component B is deployed.
/// Joins to MaintenanceEvents / MachineEvents on device_id + downtime_start for the
/// human-root-cause downtime Pareto.
table DowntimeReason

	column device_id
		dataType: string
		sourceColumn: device_id
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017001

	column downtime_start
		dataType: dateTime
		formatString: General Date
		sourceColumn: downtime_start
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017002

	column reason_code
		dataType: string
		sourceColumn: reason_code
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017003

	column category
		dataType: string
		sourceColumn: category
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017004

	column comment
		dataType: string
		sourceColumn: comment
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017005

	column corrective_action
		dataType: string
		sourceColumn: corrective_action
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017006

	column logged_by
		dataType: string
		sourceColumn: logged_by
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017007

	column logged_at
		dataType: dateTime
		formatString: General Date
		sourceColumn: logged_at
		summarizeBy: none
		lineageTag: 3f2a9d10-2008-4b7c-9e11-aa0000017008

	partition DowntimeReason = entity
		mode: directLake
		source
			entityName: DowntimeReason
			schemaName: dbo
			expressionSource: 'DirectLake - ManufacturingLH'
