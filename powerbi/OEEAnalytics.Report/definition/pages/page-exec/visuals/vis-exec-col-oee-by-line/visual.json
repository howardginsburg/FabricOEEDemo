            { "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "_Measures" } }, "Property": "Target OEE" } }, "queryRef": "_Measures.Target OEE", "nativeQueryRef": "Target OEE" } ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [ { "properties": { "text": { "expr": { "Literal": { "Value": "'OEE vs Target by Line'" } } } } } ]
